# Server-only Circle credentials. Never expose these with a NEXT_PUBLIC_ prefix.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional: reuse an existing wallet set instead of creating a new one.
CIRCLE_WALLET_SET_ID=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# Optional ERC-8004 onchain identity. Leave empty until Arc has a verified
# Identity Registry deployment and this agent has actually been registered.
ERC8004_IDENTITY_REGISTRY_ADDRESS=
ERC8004_AGENT_ID=
